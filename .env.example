# ===== Copia este archivo a ".env" y rellena los valores =====

# Proveedor del cerebro: "groq" (GRATIS) o "anthropic" (Claude, de pago)
LLM_PROVIDER=groq

# --- GROQ (gratis) --- clave en https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
# Modelo potente y gratis. Alternativas: llama-3.1-8b-instant (más rápido),
# openai/gpt-oss-120b, deepseek-r1-distill-llama-70b
GROQ_MODEL=llama-3.3-70b-versatile

# --- ANTHROPIC (Claude, de pago, opcional) ---
# Solo necesario si pones LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Token del bot de Telegram (te lo da @BotFather al crear el bot)
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tu ID de Telegram (numérico). Solo TU id podrá usar el bot.
# Para saberlo, escribe a @userinfobot en Telegram.
TELEGRAM_ALLOWED_IDS=123456789

# Token secreto para proteger la API (invéntate uno largo y aleatorio).
# Lo usará el conector MCP de Claude para autenticarse.
API_TOKEN=pon-aqui-un-token-largo-y-secreto

# Modelo de embeddings local (multilingüe, funciona en CPU sin GPU).
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Carpeta donde se guarda la base de conocimiento.
DATA_DIR=./data
